{
  "training": {
    "image": "envduels-unified:cu124",
    "gpu_ids": [0, 1, 2, 3, 4, 5, 6, 7],
    "model": "checkpoints/Qwen3.8-27B",
    "dataset": "data/envduels/fixed90-swift.jsonl",
    "export_dir": "../exports/duel_harness_004_rl",
    "output_dir": "outputs/training",

    "fixed_pool_seed": 42,
    "fixed_pool_epochs": 1,
    "max_steps": null,
    "num_games_per_rollout": 1,
    "trajectories_per_game": 8,
    "batch_size": 8,
    "per_device_train_batch_size": 1,
    "num_substeps": 1,
    "dataset_shuffle": true,
    "remove_constant_reward_groups": false,
    "max_rollout_attempts": 3,

    "learning_rate": 1e-6,
    "warmup_ratio": 0.03,
    "lr_scheduler_type": "constant",
    "adam_beta1": 0.9,
    "adam_beta2": 0.98,
    "adam_epsilon": 1e-12,
    "weight_decay": 0.1,
    "kl_penalty_coef": 0.0,
    "loss_type": "grpo",
    "reward_normalization": "grpo_no_std",
    "ppo_clip_low": 0.2,
    "ppo_clip_high": 0.28,
    "seed": 42,

    "lora_rank": 32,
    "lora_alpha": 64,
    "max_turns": 25,
    "max_context_length": 8192,
    "actor_max_tokens": 1024,
    "enable_thinking": false,
    "preserve_thinking": true,

    "vllm_tensor_parallel": 4,
    "vllm_gpu_memory_utilization": 0.45,
    "actor_temperature": 0.6,
    "actor_top_p": 0.95,
    "actor_top_k": 20,
    "overlong_filter": true,
    "rollout_json_export": true,

    "resume_from_checkpoint": null,
    "save_every": 1,
    "save_total_limit": 3
  },
  "accelerate": {
    "compute_environment": "LOCAL_MACHINE",
    "debug": false,
    "distributed_type": "FSDP",
    "downcast_bf16": "no",
    "mixed_precision": "bf16",
    "num_machines": 1,
    "num_processes": 8,
    "machine_rank": 0,
    "rdzv_backend": "static",
    "same_network": true,
    "use_cpu": false,
    "fsdp_config": {
      "fsdp_version": 2,
      "fsdp_auto_wrap_policy": "TRANSFORMER_BASED_WRAP",
      "fsdp_transformer_layer_cls_to_wrap": "Qwen3_5DecoderLayer",
      "fsdp_reshard_after_forward": true,
      "fsdp_state_dict_type": "FULL_STATE_DICT",
      "fsdp_cpu_ram_efficient_loading": true,
      "fsdp_sync_module_states": true,
      "fsdp_offload_params": false
    }
  }
}
