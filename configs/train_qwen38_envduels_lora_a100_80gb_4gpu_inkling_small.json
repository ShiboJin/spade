    "actor_top_p": 0.95,
    "actor_top_k": 50,
    "overlong_filter": true,
    "rollout_json_export": true,
    "wandb_enabled": true,
    "wandb_mode": "online",
    "wandb_project": "envduels",
    "wandb_entity": null,
