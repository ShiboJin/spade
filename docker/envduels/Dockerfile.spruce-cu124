# Experimental foundation ONLY, not a Slime/SPADE training image.
# Build this stage before selecting/rebuilding the remaining CUDA extensions.
FROM nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04@sha256:622e78a1d02c0f90ed900e3985d6c975d8e2dc9ee5e61643aed587dcf9129f42 AS foundation
LABEL org.envduels.runtime-stage="foundation-only"
ARG DEBIAN_FRONTEND=noninteractive
ARG BUILD_JOBS=4
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git build-essential python3 python3-dev python3-pip \
    libopenblas-dev libnuma-dev pkg-config
RUN python3 -m pip install 'setuptools>=70.1.0,<82' wheel 'cmake>=3.27,<4' ninja \
    'numpy==1.26.4' packaging pyyaml requests six 'typing-extensions>=4.15.0' \
    filelock sympy networkx jinja2 fsspec optree
WORKDIR /opt/src/pytorch
RUN git init && git remote add origin https://github.com/pytorch/pytorch.git && \
    git fetch --depth 1 origin 70d99e998b4955e0049d13a98d77ae1b14db1f45 && \
    git checkout --detach FETCH_HEAD && \
    git submodule update --init --recursive --jobs 4
# A100 only. Never detect the build host's GPU or silently compile CPU-only Torch.
# Limit compiler parallelism, not a hard cgroup CPU/memory limit.
ENV CUDA_HOME=/usr/local/cuda TORCH_CUDA_ARCH_LIST=8.0 \
    USE_CUDA=1 USE_CUDNN=1 USE_DISTRIBUTED=1 USE_NCCL=1 \
    BUILD_TEST=0 USE_CUSPARSELT=0 USE_CUFILE=0 \
    PYTORCH_BUILD_VERSION=2.11.0 PYTORCH_BUILD_NUMBER=1
RUN test "$BUILD_JOBS" -ge 1 && test "$BUILD_JOBS" -le 16 && \
    MAX_JOBS="$BUILD_JOBS" CMAKE_BUILD_PARALLEL_LEVEL="$BUILD_JOBS" \
    python3 setup.py bdist_wheel && \
    python3 -m pip install --no-deps dist/torch-*.whl
WORKDIR /opt
# Import outside the source checkout, without CUDA device allocation.
RUN python3 -c 'import torch; assert torch.__version__.split("+")[0] == "2.11.0"; assert torch.version.cuda == "12.4"; print(torch.__version__, torch.version.cuda)' && \
    python3 -m pip freeze > /opt/envduels-foundation-freeze.txt
# The matched Triton + CUDA extensions are a subsequent stage, NOT installed here.
# When adding Triton, use the toolkit assembler rather than its newer bundled one.
ENV TRITON_PTXAS_PATH=/usr/local/cuda/bin/ptxas
CMD ["python3", "-c", "import torch; print('FOUNDATION ONLY; not ready for training:', torch.__version__, torch.version.cuda)"]
